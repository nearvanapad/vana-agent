# LLM — any OpenAI-compatible endpoint (OpenAI, NEAR AI Cloud, OpenRouter, local).
# NEAR AI Cloud: LLM_BASE_URL=https://cloud-api.near.ai/v1 and a key from cloud.near.ai. The chat
# then offers three model tiers, and LLM_MODEL / LLM_THINK_MODEL are not used:
#   Private   (NEAR AI's own TEE GPUs)                 z-ai/glm-5.3-flash
#   Partner   (Tinfoil's TEE)                          z-ai/glm-5.3
#   Incognito (TEE gateway, provider runs the model)   openai/gpt-6-luna
# Think uses the same model with more reasoning.
# Override one as LLM_<TIER>_MODELS="normal,think" (e.g. anthropic/claude-haiku-5-5,anthropic/claude-sonnet-5-5);
# the model must handle tools. LLM_DEFAULT_TIER picks the one new users get (private).
# On NEAR AI every chat reply is also verified (free): NEAR AI signs each model call, and the server
# checks the signatures against the exact bytes and against attestations it verifies itself (Intel TDX,
# NVIDIA GPU). Private replies come back whole so the model's own TEE signs them; the others are
# signed by NEAR AI's TEE gateway. The badge under each reply shows which.
# On NEAR AI the Check tab also offers a "Web" switch: one web search per check (~$0.0055: Brave's
# $0.005 plus ~4k tokens on the model below), kept 12 h per token, capped per account per day.
LLM_WEB_MODEL=z-ai/glm-5.3-flash
WEB_SEARCH_DAILY_CAP=30
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# Optional second model for "Think" mode (defaults to LLM_MODEL). Think mode also asks for
# high reasoning effort, so pick a model that accepts reasoning_effort.
LLM_THINK_MODEL=gpt-6.1-terra

# The network the wallet signs on and swaps run on until the visitor picks one with the header
# badge: testnet (Rhea testnet pools) or mainnet (NEAR Intents + Rhea). Token checks read both
# networks either way. Build-time.
NEXT_PUBLIC_NEAR_NETWORK=testnet

# NEAR mainnet RPC (server and browser). NEAR_RPC_URL may list several, comma-separated;
# drpc.org and rpc.mainnet.near.org are always tried after it when one rate-limits.
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
# Testnet RPC, for tokens and accounts ending in .testnet (the demo token lives there).
NEAR_TESTNET_RPC_URL=https://rpc.testnet.fastnear.com

# Data sources. Keys are optional but lift rate limits.
NEARBLOCKS_API_KEY=
# Lifts FastNEAR rate limits for both the RPC and the holders API.
FASTNEAR_API_KEY=

# NEAR Intents. Swaps go through one upstream, picked here: "oneclick" (1Click direct, the
# default) or "aurora" (Aurora's Swap API over the same solvers). A swap keeps the upstream that
# quoted it, so switching never strands one in flight.
INTENTS_PROVIDER=oneclick
# 1Click. The JWT is optional: without one 1Click adds its own fee to every quote.
ONECLICK_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
# Our fee on 1Click quotes, in basis points, and the NEAR account it is paid to. Set both or
# neither (no fee). Not used with Aurora, whose fee is set per key in its portal.
INTENTS_FEE_BPS=
INTENTS_FEE_RECIPIENT=

# Sponsored account setup (optional). A deposit swap paid from another chain delivers to a NEAR
# token the account may not be registered on, and a user with no NEAR can't pay for that. With a
# sponsor account set, the server registers them (storage_deposit) before the deposit address is
# shown, and the quote adds a small fee that covers it. Needs INTENTS_FEE_BPS and
# INTENTS_FEE_RECIPIENT above, on 1Click. Without it, the user's wallet registers them.
# The key can only pay what these limits allow; give the account little NEAR. Keep it a key that
# is allowed to do nothing else.
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=
# The network the sponsor account is on. Swaps on the other one are not sponsored.
SPONSOR_NETWORK=mainnet
# The most one registration may cost, the most spent a day, and registrations per account a day.
SPONSOR_MAX_DEPOSIT_NEAR=0.01
SPONSOR_DAILY_MAX_NEAR=1
SPONSOR_ACCOUNT_DAILY_MAX=3
# The most the setup may add to what the user pays, in bps. A smaller swap registers itself.
SPONSOR_MAX_FEE_BPS=100
# Stops sponsoring when the sponsor account holds less than this.
SPONSOR_MIN_BALANCE_NEAR=0.2
# Optional: only these token contracts, comma separated. Empty is any token within the limits.
SPONSOR_TOKENS=
# Aurora Intents Swap API. The key comes from studio.aurora.dev.
AURORA_INTENTS_URL=https://intents-api.aurora.dev
AURORA_INTENTS_KEY=

# The bad demo token offered on the empty chat screen (created by `pnpm demo-token`).
NEXT_PUBLIC_DEMO_TOKEN=rug.vanarug4hgzsi.testnet

# The chat and token checks need a signed-in wallet, holding GATE_MIN of GATE_TOKEN when GATE_MIN
# is above 0 (0 for now: no NVANA needed; 500000 brings the holding back). Swaps are always open.
GATE_TOKEN=nvana.nearvana2.nearvanapad.testnet
GATE_MIN=0

# SQLite file.
DATABASE_PATH=./data/vana.db

# Public hostname Caddy serves over HTTPS: the real domain on the server, "localhost" for a local run.
DOMAIN=localhost
