# ~/apps/vana-agent/.env on the server. deploy/ship.sh adds IMAGE. The NEXT_PUBLIC_* values are
# baked into the image at build time (deploy/build.env), and DATABASE_PATH is fixed in compose.yml.

# LLM: any OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_THINK_MODEL=gpt-6.1-terra

# NEAR RPC (server side). NEAR_RPC_URL may list several, comma-separated.
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
NEAR_TESTNET_RPC_URL=https://rpc.testnet.fastnear.com

# Data sources (paid keys: they lift rate limits).
NEARBLOCKS_API_KEY=
FASTNEAR_API_KEY=

# NEAR Intents 1Click. Without a JWT every quote carries a 0.2% app fee.
ONECLICK_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# The NVANA gate on the chat and token checks. GATE_MIN=0 opens them to everyone.
GATE_TOKEN=nvana.nearvana2.nearvanapad.testnet
GATE_MIN=500000
