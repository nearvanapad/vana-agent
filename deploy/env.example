# ~/apps/vana-agent/.env on the server. deploy/ship.sh adds IMAGE. The NEXT_PUBLIC_* values are
# baked into the image at build time (deploy/build.env), and DATABASE_PATH is fixed in compose.yml.

# LLM: any OpenAI-compatible endpoint.
# Or NEAR AI Cloud (https://cloud-api.near.ai/v1): the chat then offers Private / Partner /
# Incognito model tiers; see .env.example for the models and LLM_<TIER>_MODELS overrides.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_THINK_MODEL=gpt-6.1-terra

# NEAR RPC (server side). NEAR_RPC_URL may list several, comma-separated.
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
NEAR_TESTNET_RPC_URL=https://rpc.testnet.fastnear.com

# Data sources (paid keys: they lift rate limits).
NEARBLOCKS_API_KEY=
FASTNEAR_API_KEY=

# NEAR Intents upstream: oneclick (default) or aurora.
INTENTS_PROVIDER=oneclick
# 1Click. Without a JWT 1Click adds its own fee to every quote.
ONECLICK_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
# Our 1Click fee (bps) and the NEAR account it goes to. Both or neither.
INTENTS_FEE_BPS=
INTENTS_FEE_RECIPIENT=
# Aurora Intents Swap API (key from studio.aurora.dev); only read when INTENTS_PROVIDER=aurora.
AURORA_INTENTS_URL=https://intents-api.aurora.dev
AURORA_INTENTS_KEY=

# The NVANA gate on the chat and token checks. GATE_MIN=0 (for now) asks only for a signed-in
# wallet; 500000 brings the holding back. Chat is capped at 200 messages a day per IP and per wallet.
GATE_TOKEN=nvana.nearvana2.nearvanapad.testnet
GATE_MIN=0
